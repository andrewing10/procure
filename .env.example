# ─── Required ───────────────────────────────────────────────────
# Gemini API key (Google AI Studio)
GEMINI_KEY=

# Google Maps / Places API（与 GEMINI_KEY 同一 Google Cloud 项目）
# 用于 step1 P1 Pillar 原生 Places 采集 + step3 联系方式预填充
# 配置后 P1 数据字段更丰富（电话+官网），step3 Playwright 资源可节省 40-70%
# 申请地址: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Gemini model to use for all LLM steps (default: gemini-3.1-pro-preview)
# Options: gemini-3.1-pro-preview | gemini-3.1-flash-lite | gemini-2.5-flash
GEMINI_MODEL=gemini-3.1-pro-preview

# Anthropic Claude — Gemini 失败/限流时的二级兜底（OpenAI 之前）
# 与 zhimao apps/web 同一把 key（zhimao Vercel ANTHROPIC_API_KEY 复用）
# 申请: https://console.anthropic.com/settings/keys
# 默认 model: claude-sonnet-4-6（性价比最佳，2.3s 响应）
# 可选: claude-opus-4-7 | claude-opus-4-6 | claude-sonnet-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — 三级兜底（Gemini + Claude 都失败时启用）
# GPT-5 系列必须用 max_completion_tokens（v8_lib_concurrency.js 已自动处理）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-4.1-mini

# Serper.dev API key (Google Search proxy)
SERPER_API_KEY=

# Supabase — Step5 直写 L1 + graph_edges；discovery worker 任务队列
# 也可放在 .env.local（已 gitignore，本地覆盖用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Step5 每批 upsert 条数（默认 80，最大 200）
DIRECT_L1_CHUNK=80

# ─── Optional ────────────────────────────────────────────────────
# BrightData residential proxy (only needed if USE_PROXY=true)
USE_PROXY=false
BRD_USER=
BRD_PASS=
BRD_PROXY=http://brd.superproxy.io:22225

# BrightData Scraping Browser (recommended in cloud worker)
USE_BRD_SB=false
BRD_SB_WSS=wss://brd-customer-XXXX:XXXX@brd.superproxy.io:9222

# Discovery runtime flags
DISCOVERY_JOB_ID=
SKIP_SQLITE=false

# Playwright page load timeout ms (default 15000)
PLAYWRIGHT_TIMEOUT=15000

# Step 2 intake batch size (default 50, reduce if hitting Gemini token limits)
INTAKE_BATCH_SIZE=50

# v8_infinite_loop.js delays
IDLE_DELAY_MS=10000
ERROR_DELAY_MS=30000

# ─── CRM B2：智猫 POST /api/internal/crm-watch/emit（与 apps/web 一致）───
# 站点根 URL（无尾斜杠），与 NEXT_PUBLIC_APP_URL 指向的同一主机
ZHIMAO_APP_URL=
# 与平台 Vercel 中 CRM_WATCH_EMIT_SECRET 一致；勿提交到 git
CRM_WATCH_EMIT_SECRET=
# 任务完成触达：supabase=仅写 notifications；emit=仅调 emit；both=双发（易重复，慎用）
DISCOVERY_COMPLETION_NOTIFY=supabase
# 设为 true 时，任务失败也会调 emit（dedupe_key discovery_job:<id>:failed）
CRM_WATCH_EMIT_ON_FAILURE=false
# emit 请求超时与 5xx 重试
CRM_WATCH_EMIT_TIMEOUT_MS=15000
CRM_WATCH_EMIT_MAX_RETRIES=3
