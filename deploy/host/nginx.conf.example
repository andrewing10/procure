# Phase 2+ — Nginx 反代示例（Cloudflare 橙色云 → 本机）
#
# 安装:
#   sudo cp deploy/host/nginx.conf.example /etc/nginx/sites-available/zhimao
#   # 编辑 server_name / 上游端口 / 证书路径
#   sudo ln -sf /etc/nginx/sites-available/zhimao /etc/nginx/sites-enabled/zhimao
#   sudo nginx -t && sudo systemctl reload nginx
#
# SSL: Cloudflare Full (strict) 时，源站用 Let's Encrypt 或 CF Origin Cert。
# procure 不需要本文件；仅 Chatwoot / hub / fleet 需要公网入口。

# ── 可选：只允许 Cloudflare IP 直连源站（生产建议开启）──
# 完整列表见 https://www.cloudflare.com/ips/
# include /etc/nginx/cloudflare-allow.conf;

upstream chatwoot_web {
    server 127.0.0.1:3000;
    keepalive 8;
}

upstream zhimao_hub {
    server 127.0.0.1:3001;
    keepalive 8;
}

upstream zhimao_fleet {
    server 127.0.0.1:3002;
    keepalive 8;
}

# HTTP → HTTPS（CF 灵活模式可省略；Full/strict 建议保留）
server {
    listen 80;
    listen [::]:80;
    server_name chat.example.com hub.example.com fleet.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Chatwoot
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chat.example.com;

    ssl_certificate     /etc/ssl/certs/example.com.pem;
    ssl_certificate_key /etc/ssl/private/example.com.key;

    client_max_body_size 50m;

    location / {
        proxy_pass http://chatwoot_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# zhimao-hub
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hub.example.com;

    ssl_certificate     /etc/ssl/certs/example.com.pem;
    ssl_certificate_key /etc/ssl/private/example.com.key;

    location / {
        proxy_pass http://zhimao_hub;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}

# zhimao-fleet-api
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fleet.example.com;

    ssl_certificate     /etc/ssl/certs/example.com.pem;
    ssl_certificate_key /etc/ssl/private/example.com.key;

    location / {
        proxy_pass http://zhimao_fleet;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
